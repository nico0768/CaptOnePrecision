# Copier ce fichier en .env.local (en local) et renseigner les mêmes
# variables dans Vercel : Project → Settings → Environment Variables.

# URL publique du site (ex. https://capt-one-precision.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Formulaire de contact — https://resend.com (offre gratuite)
RESEND_API_KEY=
# Adresse qui reçoit les messages
CONTACT_TO_EMAIL=
# Expéditeur. Sans domaine vérifié chez Resend, laisser vide :
# l'adresse de test onboarding@resend.dev sera utilisée (elle ne peut
# envoyer qu'à l'adresse du compte Resend).
CONTACT_FROM_EMAIL=

# Tableau de bord (/admin)
# Mot de passe de connexion. Sans lui, le tableau de bord reste fermé.
ADMIN_PASSWORD=
# Sert aussi à signer les sessions des clients : le changer les déconnecte.
# Sur Vercel uniquement : Storage > Create > Blob, puis relier au projet (ajoute la variable toute seule).
# Sans cela, le tableau de bord ne peut rien enregistrer en ligne.
BLOB_READ_WRITE_TOKEN=

# Comptes clients et réservations, sur Vercel uniquement : créer un DEUXIÈME stockage Blob,
# en accès PRIVÉ, puis copier son jeton ici. Sans lui, l'inscription et la réservation restent fermées en ligne.
BLOB_PRIVE_READ_WRITE_TOKEN=
